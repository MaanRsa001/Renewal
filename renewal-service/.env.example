# Copy to .env and fill in real values for local development.
# Spring Boot does not read .env files natively - use this either with
# `export $(cat .env | xargs)` before running, or with a tool like
# spring-dotenv / docker-compose's env_file, or your IDE's run-config
# environment variables panel.

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=renewal_db
DB_USER=renewal_user
DB_PASSWORD=changeme

# ---------- Security ----------
# Generate a real one, e.g.: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-in-every-environment-0123456789
JWT_EXPIRATION_MINUTES=60

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------- App behavior ----------
RENEWAL_BATCH_CHUNK_SIZE=500
APP_LOG_LEVEL=DEBUG

# ---------- Server ----------
SERVER_PORT=8080

# ---------- Active profile ----------
# dev | prod | test - leave unset to use application.properties defaults only
SPRING_PROFILES_ACTIVE=dev
